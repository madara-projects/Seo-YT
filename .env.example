# Environment settings for YouTube SEO Analyzer

# YouTube Data API v3 (Required)
WIN_ENGINE_YOUTUBE_API_KEY=
WIN_ENGINE_YOUTUBE_API_KEYS=
WIN_ENGINE_YOUTUBE_MAX_RESULTS=5

# YouTube channel connection (Stage 4). Create a Web OAuth client in Google Cloud.
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_ID=
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_SECRET=
WIN_ENGINE_YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WIN_ENGINE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Optional cloud fallback. Used only when local Ollama cannot generate.
WIN_ENGINE_GEMINI_API_KEY=
WIN_ENGINE_GEMINI_MODEL=gemini-3.5-flash

# Ollama — REQUIRED for accurate, dynamic SEO output.
# Install: https://ollama.ai  →  then `ollama pull mistral`
# Daemon runs on http://localhost:11434 by default.
# When Ollama is offline the app uses Gemini when configured, then a local template.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=30

# Database & Caching
WIN_ENGINE_DATABASE_PATH=win_engine.db
WIN_ENGINE_REDIS_URL=
WIN_ENGINE_CACHE_TTL_TRENDING_SECONDS=21600
WIN_ENGINE_CACHE_TTL_EVERGREEN_SECONDS=604800

# Access control
WIN_ENGINE_PUBLIC_DIAGNOSTICS_ENABLED=true
WIN_ENGINE_ADMIN_API_TOKEN=
WIN_ENGINE_RATE_LIMIT_WINDOW_SECONDS=60
WIN_ENGINE_RATE_LIMIT_MAX_REQUESTS=60

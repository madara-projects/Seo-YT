# Environment settings for YouTube SEO Analyzer
# "production" (the default) requires WIN_ENGINE_ADMIN_API_TOKEN for the admin
# endpoints (/ready, /api/reset-database); "development" opens them without one.
WIN_ENGINE_APP_ENVIRONMENT=production
WIN_ENGINE_BIND_HOST=127.0.0.1
# DEBUG, INFO, WARNING or ERROR (any case). DEBUG applies to the app's own
# modules; the HTTP and OAuth libraries stay at WARNING, since their debug
# lines carry API keys, client secrets and tokens.
WIN_ENGINE_LOG_LEVEL=INFO

# YouTube Data API v3 (optional; required only for live public research)
WIN_ENGINE_YOUTUBE_API_KEY=
WIN_ENGINE_YOUTUBE_API_KEYS=
# Results per search, 1-50. A search counts as one call whatever the page
# size, and the page's statistics cost 2 units however long it is, so 25
# costs exactly what 5 did. A Short's searches ask only for short videos
# (under 4 minutes); a long-form video's ask for every length, unless its
# stated length sits more than 3 minutes inside YouTube's medium (4-20
# minutes) or long (over 20) band.
WIN_ENGINE_YOUTUBE_MAX_RESULTS=25
# Daily quota of each key's Google Cloud project (and the OAuth client's), as
# shown on the YouTube Data API v3 quotas page in Google Cloud Console. YouTube
# does not report what is left, so the app counts its own requests, shows them
# in Settings and warns at 90%; it never blocks a request. search.list has its
# own bucket of calls (100 a day by default); every other method draws units
# from a shared bucket (10,000 a day by default; each read the app makes costs
# 1). A Short plans at most 3 searches, a long video about 5-7. Quotas reset at
# midnight Pacific time.
WIN_ENGINE_YOUTUBE_SEARCH_CALLS_PER_DAY=100
WIN_ENGINE_YOUTUBE_UNITS_PER_DAY=10000

# YouTube channel connection (Stage 4). Create a Web OAuth client in Google Cloud.
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_ID=
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_SECRET=
WIN_ENGINE_YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WIN_ENGINE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Gemini is the optional primary generator; a content-specific local fallback remains available.
WIN_ENGINE_GEMINI_API_KEY=
WIN_ENGINE_GEMINI_MODEL=gemini-3.5-flash-lite
# Backup model, tried once when the main model is overloaded (HTTP 503) or
# rate-limited (429) before the local fallback writer takes over. Set it empty
# to disable. Newer "flash"/"pro" models were slower and hit rate limits sooner
# on a standard key during testing, so a lite model is the default.
WIN_ENGINE_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Seconds per Gemini request. 30 timed out routinely on full packages.
WIN_ENGINE_GEMINI_TIMEOUT_SECONDS=60
# Advanced tuning (defaults shown). A value outside its allowed range stops
# the app at startup with a message naming the setting.
# WIN_ENGINE_GEMINI_TRANSIENT_RETRIES=1
# WIN_ENGINE_GEMINI_RATE_LIMIT_RETRIES=2
# WIN_ENGINE_GEMINI_RETRY_BASE_SECONDS=0.75
# Longest wait before a retry; a longer Retry-After from Gemini ends that
# model's attempts at once.
# WIN_ENGINE_GEMINI_MAX_RETRY_WAIT_SECONDS=20
# WIN_ENGINE_GEMINI_OUTPUT_TOKEN_CEILING=8192
# WIN_ENGINE_GEMINI_COOLDOWN_FAILURE_THRESHOLD=2
# WIN_ENGINE_GEMINI_COOLDOWN_SECONDS=60
# Most Gemini calls, and seconds, one analysis, idea or demand request may spend.
# WIN_ENGINE_GEMINI_REQUEST_MAX_CALLS=12
# WIN_ENGINE_GEMINI_REQUEST_DEADLINE_SECONDS=300
# Calls of that allowance kept for the package writer: research stops making
# Gemini calls when only this many are left.
# WIN_ENGINE_GEMINI_WRITER_RESERVED_CALLS=3

# Search demand: YouTube search suggestions — the phrases viewers actually type.
# This is demand evidence, not search volume. It uses YouTube's unofficial
# suggestion endpoint (the one the search box calls), so every lookup is
# bounded, cached for 3 days, and fails soft: if it is unreachable, packages
# are generated without it. Set to false to never contact it.
WIN_ENGINE_SEARCH_SUGGEST_ENABLED=true
WIN_ENGINE_SEARCH_SUGGEST_TIMEOUT_SECONDS=3
WIN_ENGINE_SEARCH_SUGGEST_MAX_QUERIES=6

# Database & Caching
WIN_ENGINE_DATABASE_PATH=runtime/data/win_engine.db
# IANA timezone used for upload guidance when connected analytics do not supply one.
WIN_ENGINE_CREATOR_TIMEZONE=Asia/Kolkata
WIN_ENGINE_REDIS_URL=
WIN_ENGINE_CACHE_TTL_TRENDING_SECONDS=21600
WIN_ENGINE_CACHE_TTL_EVERGREEN_SECONDS=604800

# Optional offline-first History synchronization through Aiven MySQL.
WIN_ENGINE_CLOUD_SYNC_ENABLED=false
WIN_ENGINE_CLOUD_SYNC_DEVICE_ID=
WIN_ENGINE_CLOUD_SYNC_HOST=
WIN_ENGINE_CLOUD_SYNC_PORT=3306
WIN_ENGINE_CLOUD_SYNC_DATABASE=seo_yt_sync
WIN_ENGINE_CLOUD_SYNC_USER=seo_yt_app
WIN_ENGINE_CLOUD_SYNC_PASSWORD=
# Path inside the container; compose.yaml mounts runtime/secrets/aiven-ca.pem here.
WIN_ENGINE_CLOUD_SYNC_SSL_CA_PATH=/run/secrets/aiven-ca.pem
WIN_ENGINE_CLOUD_SYNC_INTERVAL_SECONDS=60
WIN_ENGINE_CLOUD_SYNC_INITIAL_DELAY_SECONDS=10
# After runs that cannot reach the cloud, the wait doubles up to this many seconds.
WIN_ENGINE_CLOUD_SYNC_RETRY_MAX_SECONDS=900

# Scheduled 24h/7d/28d snapshots of linked videos (uses the connected channel).
WIN_ENGINE_SNAPSHOT_COLLECTOR_ENABLED=false
WIN_ENGINE_SNAPSHOT_COLLECTOR_DRY_RUN=false
WIN_ENGINE_SNAPSHOT_COLLECTOR_INTERVAL_SECONDS=21600
WIN_ENGINE_SNAPSHOT_COLLECTOR_INITIAL_DELAY_SECONDS=30
WIN_ENGINE_SNAPSHOT_COLLECTOR_MAX_LINKS_PER_RUN=3
WIN_ENGINE_SNAPSHOT_COLLECTOR_RETRY_BASE_SECONDS=21600
WIN_ENGINE_SNAPSHOT_COLLECTOR_RETRY_MAX_SECONDS=172800

# Access control. The app answers only on the loopback address and only to
# these host names (ports ignored); a write sent by another website is
# refused. The admin token guards /ready and /api/reset-database.
WIN_ENGINE_ADMIN_API_TOKEN=
WIN_ENGINE_ALLOWED_HOSTS=127.0.0.1,localhost,::1
WIN_ENGINE_RATE_LIMIT_WINDOW_SECONDS=60
WIN_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
# Per route, for requests that spend YouTube quota or Gemini calls.
WIN_ENGINE_ANALYZE_RATE_LIMIT_MAX_REQUESTS=8
WIN_ENGINE_MAX_REQUEST_BYTES=1048576

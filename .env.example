# Environment settings for YouTube SEO Analyzer

# YouTube Data API v3 (Required)
WIN_ENGINE_YOUTUBE_API_KEY=
WIN_ENGINE_YOUTUBE_API_KEYS=
WIN_ENGINE_YOUTUBE_MAX_RESULTS=5

# Ollama (replaces all prior HuggingFace usage)
# - Local dev:               http://localhost:11434
# - Minikube (Docker driver / Win+Mac): http://host.docker.internal:11434
# - In-cluster Ollama Service: http://ollama.default.svc.cluster.local:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=20

# Database & Caching
WIN_ENGINE_DATABASE_PATH=win_engine.db
WIN_ENGINE_REDIS_URL=
WIN_ENGINE_CACHE_TTL_TRENDING_SECONDS=21600
WIN_ENGINE_CACHE_TTL_EVERGREEN_SECONDS=604800

# Advanced Features & Localization
WIN_ENGINE_PUBLIC_DIAGNOSTICS_ENABLED=true
WIN_ENGINE_ADMIN_API_TOKEN=
WIN_ENGINE_ENABLED_LANGUAGES=english,tamil,tanglish,hindi
WIN_ENGINE_DEFAULT_REGION=INDIA

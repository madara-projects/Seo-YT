# Environment settings for YouTube SEO Analyzer
WIN_ENGINE_APP_ENVIRONMENT=production
WIN_ENGINE_BIND_HOST=127.0.0.1

# YouTube Data API v3 (optional; required only for live public research)
WIN_ENGINE_YOUTUBE_API_KEY=
WIN_ENGINE_YOUTUBE_API_KEYS=
WIN_ENGINE_YOUTUBE_MAX_RESULTS=5

# YouTube channel connection (Stage 4). Create a Web OAuth client in Google Cloud.
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_ID=
WIN_ENGINE_YOUTUBE_OAUTH_CLIENT_SECRET=
WIN_ENGINE_YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WIN_ENGINE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Gemini is the optional primary generator; a content-specific local fallback remains available.
WIN_ENGINE_GEMINI_API_KEY=
WIN_ENGINE_GEMINI_MODEL=gemini-3.5-flash-lite
# Backup model, tried once when the main model is overloaded (HTTP 503) or
# rate-limited (429) before the local fallback writer takes over. Set it empty
# to disable. Newer "flash"/"pro" models were slower and hit rate limits sooner
# on a standard key during testing, so a lite model is the default.
WIN_ENGINE_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Seconds per Gemini request. 30 timed out routinely on full packages.
WIN_ENGINE_GEMINI_TIMEOUT_SECONDS=60
# Advanced tuning (defaults shown):
# WIN_ENGINE_GEMINI_TRANSIENT_RETRIES=1
# WIN_ENGINE_GEMINI_RATE_LIMIT_RETRIES=2
# WIN_ENGINE_GEMINI_OUTPUT_TOKEN_CEILING=8192
# WIN_ENGINE_GEMINI_COOLDOWN_FAILURE_THRESHOLD=2
# WIN_ENGINE_GEMINI_COOLDOWN_SECONDS=60

# Search demand: YouTube search suggestions — the phrases viewers actually type.
# This is demand evidence, not search volume. It uses YouTube's unofficial
# suggestion endpoint (the one the search box calls), so every lookup is
# bounded, cached for 3 days, and fails soft: if it is unreachable, packages
# are generated without it. Set to false to never contact it.
WIN_ENGINE_SEARCH_SUGGEST_ENABLED=true
WIN_ENGINE_SEARCH_SUGGEST_TIMEOUT_SECONDS=3
WIN_ENGINE_SEARCH_SUGGEST_MAX_QUERIES=6

# Database & Caching
WIN_ENGINE_DATABASE_PATH=runtime/data/win_engine.db
# IANA timezone used for upload guidance when connected analytics do not supply one.
WIN_ENGINE_CREATOR_TIMEZONE=Asia/Kolkata
WIN_ENGINE_REDIS_URL=
WIN_ENGINE_CACHE_TTL_TRENDING_SECONDS=21600
WIN_ENGINE_CACHE_TTL_EVERGREEN_SECONDS=604800

# Optional offline-first History synchronization through Aiven MySQL.
WIN_ENGINE_CLOUD_SYNC_ENABLED=false
WIN_ENGINE_CLOUD_SYNC_DEVICE_ID=
WIN_ENGINE_CLOUD_SYNC_HOST=
WIN_ENGINE_CLOUD_SYNC_PORT=3306
WIN_ENGINE_CLOUD_SYNC_DATABASE=seo_yt_sync
WIN_ENGINE_CLOUD_SYNC_USER=seo_yt_app
WIN_ENGINE_CLOUD_SYNC_PASSWORD=
WIN_ENGINE_CLOUD_SYNC_SSL_CA_PATH=/run/secrets/aiven-ca.pem
WIN_ENGINE_CLOUD_SYNC_INTERVAL_SECONDS=60
WIN_ENGINE_CLOUD_SYNC_INITIAL_DELAY_SECONDS=10

# Access control
WIN_ENGINE_ADMIN_API_TOKEN=
WIN_ENGINE_RATE_LIMIT_WINDOW_SECONDS=60
WIN_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
